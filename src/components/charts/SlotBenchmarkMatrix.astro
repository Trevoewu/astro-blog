  hint: isZh ? '点击任意一行展开规模、SOTA 溯源与优缺点' : 'Click any row to expand scale, SOTA provenance, and caveats',
  scopeLabel: isZh ? '范围' : 'Scope',
  turnLabel: isZh ? '轮次' : 'Turn',
  langLabel: isZh ? '语言' : 'Language',
  tagLabel: isZh ? '特性' : 'Tags',
  searchPlaceholder: isZh ? '搜索数据集、槽位特性、引用或挑战…' : 'Search dataset, schema, citation, or challenge…',
  searchLabel: isZh ? '筛选关键词' : 'Filter benchmarks by keyword',
  all: isZh ? '全部' : 'All',
  deepDive: isZh ? '深度精讲' : 'Deep-Dive',
  landscape: isZh ? '全景速览' : 'Landscape',
  singleTurn: isZh ? '单轮' : 'Single-turn',
  multiTurn: isZh ? '多轮' : 'Multi-turn',
  langEn: isZh ? '英文' : 'English',
  langMulti: isZh ? '多语 / 双语' : 'Multilingual',
  langZh: isZh ? '中文' : 'Chinese',
  expandAll: isZh ? '展开全部' : 'Expand all',
  collapseAll: isZh ? '收起全部' : 'Collapse all',
  reset: isZh ? '重置' : 'Reset',
  colDataset: isZh ? '数据集' : 'Dataset',
  colTurnLang: isZh ? '轮次 · 语言' : 'Turn · Lang',
  colSchema: isZh ? '领域与 Schema' : 'Domains & Schema',
  colChallenge: isZh ? '零样本 / LLM 核心挑战' : 'Zero-Shot / LLM Challenge',
  detailScale: isZh ? '规模与划分' : 'Scale & Splits',
  detailCitation: isZh ? '主要引用' : 'Primary Citation',
  detailSchema: isZh ? 'Schema 类型' : 'Schema Type',
  detailFullSota: isZh ? '全量 SOTA' : 'Full-Shot SOTA',
  detailZsSota: isZh ? '零样本 / 少样本 / LLM' : 'Zero-Shot / Few-Shot / LLM',
  detailPros: isZh ? '优势' : 'Strengths',
  detailCons: isZh ? '局限' : 'Caveats',
  emptyTitle: isZh ? '没有符合当前筛选条件的基准。' : 'No benchmarks match the active filters.',
  pitfallNote: isZh
    ? '注：Banking77（77 意图、0 槽位）与 CLINC150（150 意图 + OOS、0 槽位）属于纯意图 / 域外检测数据集，不提供槽位标注，故未列入本矩阵。'
    : 'Note: Banking77 (77 intents, 0 slots) and CLINC150 (150 intents + OOS, 0 slots) are intent/OOS-only datasets with no slot spans, so they are intentionally excluded from this matrix.',
};

const totalCount = benchmarks.length;
const initialSummary = isZh
  ? `显示 ${totalCount} / ${totalCount} 个基准`
  : `Showing ${totalCount} of ${totalCount} benchmarks`;
---

<slot-benchmark-matrix
  data-lang={lang}
  data-default-scope={defaultScope}
  data-default-turn={defaultTurn}
  data-total={totalCount}
  role="region"
  aria-label={ui.regionLabel}
>
  <div class="bm-header">
    <div class="bm-title-group">
      <h5 class="bm-title" id={`${idPrefix}bm-heading`}>{ui.title}</h5>
      <span class="bm-hint">{ui.hint}</span>
    </div>
    <div class="bm-header-actions">
      <output class="bm-count" aria-live="polite">{initialSummary}</output>
      <button type="button" class="bm-text-btn" data-action="toggle-all" data-expanded="false">
        {ui.expandAll}
      </button>
      <button type="button" class="bm-text-btn" data-action="reset" hidden>
        {ui.reset}
      </button>
    </div>
  </div>

  <div class="bm-controls" aria-labelledby={`${idPrefix}bm-heading`}>
    <div class="bm-filter-groups">
      <div class="bm-group" role="group" aria-label={ui.scopeLabel}>
        <span class="bm-group-label">{ui.scopeLabel}</span>
        <div class="bm-pills">
          <button type="button" class="bm-pill" data-filter="scope" data-value="all" aria-pressed={defaultScope === 'all' ? 'true' : 'false'}>{ui.all}</button>
          <button type="button" class="bm-pill" data-filter="scope" data-value="deep-dive" aria-pressed={defaultScope === 'deep-dive' ? 'true' : 'false'}>{ui.deepDive}</button>
          <button type="button" class="bm-pill" data-filter="scope" data-value="landscape" aria-pressed={defaultScope === 'landscape' ? 'true' : 'false'}>{ui.landscape}</button>
        </div>
      </div>

      <div class="bm-group" role="group" aria-label={ui.turnLabel}>
        <span class="bm-group-label">{ui.turnLabel}</span>
        <div class="bm-pills">
          <button type="button" class="bm-pill" data-filter="turn" data-value="all" aria-pressed={defaultTurn === 'all' ? 'true' : 'false'}>{ui.all}</button>
          <button type="button" class="bm-pill" data-filter="turn" data-value="single" aria-pressed={defaultTurn === 'single' ? 'true' : 'false'}>{ui.singleTurn}</button>
          <button type="button" class="bm-pill" data-filter="turn" data-value="multi" aria-pressed={defaultTurn === 'multi' ? 'true' : 'false'}>{ui.multiTurn}</button>
        </div>
      </div>

      <div class="bm-group" role="group" aria-label={ui.langLabel}>
        <span class="bm-group-label">{ui.langLabel}</span>
        <div class="bm-pills">
          <button type="button" class="bm-pill" data-filter="lang" data-value="all" aria-pressed="true">{ui.all}</button>
          <button type="button" class="bm-pill" data-filter="lang" data-value="en" aria-pressed="false">{ui.langEn}</button>
          <button type="button" class="bm-pill" data-filter="lang" data-value="multilingual" aria-pressed="false">{ui.langMulti}</button>
          <button type="button" class="bm-pill" data-filter="lang" data-value="zh" aria-pressed="false">{ui.langZh}</button>
        </div>
      </div>
    </div>

    <div class="bm-search-tags">
      <label class="bm-search-wrap" for={`${idPrefix}bm-search`}>
        <span class="sr-only">{ui.searchLabel}</span>
        <input
          id={`${idPrefix}bm-search`}
          class="bm-search"
          type="search"
          placeholder={ui.searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <div class="bm-tags-row" role="group" aria-label={ui.tagLabel}>
        <span class="bm-group-label">{ui.tagLabel}</span>
        <div class="bm-pills">
          {tagOrder.map((tag) => (
            <button
              type="button"
              class="bm-chip"
              data-filter="tag"
              data-value={tag}
              aria-pressed="false"
            >
              {t(tagLabels[tag])}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="bm-table-head" aria-hidden="true">
    <span>{ui.colDataset}</span>
    <span>{ui.colTurnLang}</span>
    <span>{ui.colSchema}</span>
    <span>{ui.colChallenge}</span>
    <span></span>
  </div>

  <div class="bm-list">
    {benchmarks.map((item) => {
      const searchBlob = [
        item.name,
        item.year,
        item.citation,
        item.languages.en,
        item.languages.zh,
        item.domains.en,
        item.domains.zh,
        item.scale.en,
        item.scale.zh,
        item.schemaType.en,
        item.schemaType.zh,
        item.challenge.en,
        item.challenge.zh,
        item.sotaFull?.en ?? '',
        item.sotaFull?.zh ?? '',
        item.sotaZeroShot?.en ?? '',
        item.sotaZeroShot?.zh ?? '',
        ...item.tags.flatMap((tag) => [tag, tagLabels[tag].en, tagLabels[tag].zh]),
      ]
        .join(' ')
        .toLowerCase();

      return (
        <details
          class="bm-row"
          data-id={item.id}
          data-turn={item.turn}
          data-scope={item.scope}
          data-lang-group={item.langGroup}
          data-tags={item.tags.join(',')}
          data-search={searchBlob}
        >
          <summary class="bm-summary">
            <span class="bm-cell bm-cell-name">
              <strong class="bm-name">{item.name}</strong>
              <span class="bm-meta-line">
                <span class="bm-year">{item.year}</span>
                <span class={`bm-scope-badge ${item.scope === 'deep-dive' ? 'is-deep' : 'is-land'}`}>
                  {item.scope === 'deep-dive' ? ui.deepDive : ui.landscape}
                </span>
              </span>
            </span>

            <span class="bm-cell bm-cell-turn">
              <span class="bm-badge">{item.turn === 'single' ? ui.singleTurn : ui.multiTurn}</span>
              <span class="bm-sub">{t(item.languages)}</span>
            </span>

            <span class="bm-cell bm-cell-schema">
              <span class="bm-primary">{t(item.domains)}</span>
              <span class="bm-sub">{t(item.schemaType)}</span>
            </span>

            <span class="bm-cell bm-cell-challenge">
              <span class="bm-challenge-text">{t(item.challenge)}</span>
            </span>

            <span class="bm-chevron" aria-hidden="true">▸</span>
          </summary>

          <div class="bm-detail">
            <dl class="bm-dl">
              <div class="bm-dl-item">
                <dt>{ui.detailScale}</dt>
                <dd>{t(item.scale)}</dd>
              </div>
              <div class="bm-dl-item">
                <dt>{ui.detailCitation}</dt>
                <dd>{item.citation}</dd>
              </div>
              <div class="bm-dl-item">
                <dt>{ui.detailSchema}</dt>
                <dd>{t(item.schemaType)}</dd>
              </div>
              {item.sotaFull && (
                <div class="bm-dl-item bm-dl-wide">
                  <dt>{ui.detailFullSota}</dt>
                  <dd>{t(item.sotaFull)}</dd>
                </div>
              )}
              {item.sotaZeroShot && (
                <div class="bm-dl-item bm-dl-wide">
                  <dt>{ui.detailZsSota}</dt>
                  <dd>{t(item.sotaZeroShot)}</dd>
                </div>
              )}
              {item.pros && (
                <div class="bm-dl-item">
                  <dt>{ui.detailPros}</dt>
                  <dd>{t(item.pros)}</dd>
                </div>
              )}
              {item.cons && (
                <div class="bm-dl-item">
                  <dt>{ui.detailCons}</dt>
                  <dd>{t(item.cons)}</dd>
                </div>
              )}
            </dl>
            <div class="bm-detail-tags">
              {item.tags.map((tag) => (
                <span class="bm-tag-pill">{t(tagLabels[tag])}</span>
              ))}
            </div>
          </div>
        </details>
      );
    })}
  </div>

  <div class="bm-empty" hidden>
    <span>{ui.emptyTitle}</span>
    <button type="button" class="bm-text-btn" data-action="reset">
      {ui.reset}
    </button>
  </div>

  <p class="bm-footnote">{ui.pitfallNote}</p>
</slot-benchmark-matrix>

<script>
  class SlotBenchmarkMatrix extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';

      const isZh = this.dataset.lang === 'zh';
      const defaultScope = this.dataset.defaultScope || 'all';
      const defaultTurn = this.dataset.defaultTurn || 'all';
      const total = Number(this.dataset.total || '0');

      const rows = Array.from(this.querySelectorAll<HTMLDetailsElement>('.bm-row'));
      const filterButtons = Array.from(
        this.querySelectorAll<HTMLButtonElement>('button[data-filter]'),
      );
      const searchInput = this.querySelector<HTMLInputElement>('.bm-search');
      const countOutput = this.querySelector<HTMLOutputElement>('.bm-count');
      const emptyState = this.querySelector<HTMLElement>('.bm-empty');
      const toggleAllBtn = this.querySelector<HTMLButtonElement>('button[data-action="toggle-all"]');
      const resetBtns = Array.from(
        this.querySelectorAll<HTMLButtonElement>('button[data-action="reset"]'),
      );

      let activeScope = defaultScope;
      let activeTurn = defaultTurn;
      let activeLang = 'all';
      let query = '';
      const activeTags = new Set<string>();

      const updateCount = (visibleCount: number) => {
        if (!countOutput) return;
        countOutput.textContent = isZh
          ? `显示 ${visibleCount} / ${total} 个基准`
          : `Showing ${visibleCount} of ${total} benchmarks`;
      };

      const syncToggleAllLabel = () => {
        if (!toggleAllBtn) return;
        const visibleRows = rows.filter((row) => !row.hidden);
        const allOpen = visibleRows.length > 0 && visibleRows.every((row) => row.open);
        toggleAllBtn.dataset.expanded = allOpen ? 'true' : 'false';
        toggleAllBtn.textContent = allOpen
          ? isZh
            ? '收起全部'
            : 'Collapse all'
          : isZh
            ? '展开全部'
            : 'Expand all';
        toggleAllBtn.hidden = visibleRows.length === 0;
      };

      const syncButtons = () => {
        for (const btn of filterButtons) {
          const kind = btn.dataset.filter;
          const val = btn.dataset.value || '';
          let pressed = false;
          if (kind === 'scope') pressed = val === activeScope;
          else if (kind === 'turn') pressed = val === activeTurn;
          else if (kind === 'lang') pressed = val === activeLang;
          else if (kind === 'tag') pressed = activeTags.has(val);
          btn.setAttribute('aria-pressed', pressed ? 'true' : 'false');
        }

        const isDirty =
          activeScope !== defaultScope ||
          activeTurn !== defaultTurn ||
          activeLang !== 'all' ||
          activeTags.size > 0 ||
          query.trim().length > 0;

        for (const btn of resetBtns) {
          if (btn.closest('.bm-header-actions')) {
            btn.hidden = !isDirty;
          }
        }
      };

      const applyFilters = () => {
        const terms = query
          .trim()
          .toLowerCase()
          .split(/\s+/)
          .filter(Boolean);

        let visibleCount = 0;

        for (const row of rows) {
          const matchScope = activeScope === 'all' || row.dataset.scope === activeScope;
          const matchTurn = activeTurn === 'all' || row.dataset.turn === activeTurn;
          const matchLang = activeLang === 'all' || row.dataset.langGroup === activeLang;

          let matchTags = true;
          if (activeTags.size > 0) {
            const rowTags = new Set((row.dataset.tags || '').split(',').filter(Boolean));
            for (const tag of activeTags) {
              if (!rowTags.has(tag)) {
                matchTags = false;
                break;
              }
            }
          }

          let matchQuery = true;
          if (terms.length > 0) {
            const haystack = row.dataset.search || '';
            matchQuery = terms.every((term) => haystack.includes(term));
          }

          const visible = matchScope && matchTurn && matchLang && matchTags && matchQuery;
          row.hidden = !visible;
          if (visible) visibleCount += 1;
        }

        if (emptyState) emptyState.hidden = visibleCount > 0;
        updateCount(visibleCount);
        syncButtons();
        syncToggleAllLabel();
      };

      for (const btn of filterButtons) {
        btn.addEventListener('click', () => {
          const kind = btn.dataset.filter;
          const val = btn.dataset.value || '';
          if (kind === 'scope') activeScope = val;
          else if (kind === 'turn') activeTurn = val;
          else if (kind === 'lang') activeLang = val;
          else if (kind === 'tag') {
            if (activeTags.has(val)) activeTags.delete(val);
            else activeTags.add(val);
          }
          applyFilters();
        });
      }

      searchInput?.addEventListener('input', () => {
        query = searchInput.value;
        applyFilters();
      });

      toggleAllBtn?.addEventListener('click', () => {
        const visibleRows = rows.filter((row) => !row.hidden);
        const shouldOpen = toggleAllBtn.dataset.expanded !== 'true';
        for (const row of visibleRows) {
          row.open = shouldOpen;
        }
        syncToggleAllLabel();
      });

      for (const row of rows) {
        row.addEventListener('toggle', syncToggleAllLabel);
      }

      for (const btn of resetBtns) {
        btn.addEventListener('click', () => {
          activeScope = defaultScope;
          activeTurn = defaultTurn;
          activeLang = 'all';
          activeTags.clear();
          query = '';
          if (searchInput) searchInput.value = '';
          applyFilters();
        });
      }

      applyFilters();
    }
  }

  if (!customElements.get('slot-benchmark-matrix')) {
    customElements.define('slot-benchmark-matrix', SlotBenchmarkMatrix);
  }
</script>

<style>
  slot-benchmark-matrix {
    display: block;
    min-width: 0;
    margin-block: 1.75em;
    container-type: inline-size;
    --bm-border: color-mix(in srgb, var(--theme-sub-text) 28%, transparent);
    --bm-border-strong: color-mix(in srgb, var(--theme-sub-text) 52%, transparent);
    --bm-surface: color-mix(in srgb, var(--theme-code-block) 58%, transparent);
    --bm-surface-hover: color-mix(in srgb, var(--theme-code-block) 88%, transparent);
    --bm-accent: light-dark(var(--color-klein-light), #a3bbff);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bm-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 0.75rem;
  }

  .bm-title-group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .bm-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--theme-text);
  }

  .bm-hint {
    font-size: 0.78rem;
    color: var(--theme-sub-text);
  }

  .bm-header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.78rem;
  }

  .bm-count {
    color: var(--theme-sub-text);
  }

  .bm-text-btn {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.78rem;
    color: var(--theme-sub-text);
    text-decoration: underline;
    text-decoration-color: var(--theme-link-underline);
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .bm-text-btn[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .bm-text-btn:hover {
      color: var(--theme-text);
      text-decoration-color: currentColor;
      text-decoration-thickness: 2px;
    }
  }

  .bm-controls {
    display: grid;
    gap: 0.6rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--bm-border);
    background: var(--bm-surface);
    border-radius: 2px;
    margin-bottom: 0.6rem;
  }

  .bm-filter-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    align-items: center;
  }

  .bm-group,
  .bm-tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
  }

  .bm-group-label {
    font-size: 0.72rem;
    color: var(--theme-sub-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .bm-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .bm-pill,
  .bm-chip {
    appearance: none;
    padding: 0.16rem 0.48rem;
    border: 1px solid var(--bm-border);
    border-radius: 2px;
    background: var(--theme-bg);
    color: var(--theme-text);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.45;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }

  .bm-chip {
    background: transparent;
    color: var(--theme-sub-text);
  }

  .bm-pill[aria-pressed='true'],
  .bm-chip[aria-pressed='true'] {
    background: var(--theme-text);
    border-color: var(--theme-text);
    color: var(--theme-bg);
  }

  @media (hover: hover) and (pointer: fine) {
    .bm-pill[aria-pressed='false']:hover,
    .bm-chip[aria-pressed='false']:hover {
      border-color: var(--bm-border-strong);
      color: var(--theme-text);
      background: var(--bm-surface-hover);
    }
  }

  .bm-pill:focus-visible,
  .bm-chip:focus-visible,
  .bm-text-btn:focus-visible,
  .bm-summary:focus-visible,
  .bm-search:focus-visible {
    outline: 2px solid transparent;
    box-shadow: 0 0 0 2px var(--theme-text);
  }

  .bm-pill:focus-visible,
  .bm-chip:focus-visible,
  .bm-text-btn:focus-visible {
    background-color: var(--theme-text);
    color: var(--theme-bg);
    text-decoration-color: transparent;
  }

  .bm-search-tags {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--bm-border);
  }

  .bm-search-wrap {
    display: block;
    width: 100%;
  }

  .bm-search {
    width: 100%;
    padding: 0.34rem 0.6rem;
    border: 1px solid var(--bm-border);
    border-radius: 2px;
    background: var(--theme-bg);
    color: var(--theme-text);
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .bm-search::placeholder {
    color: var(--theme-sub-text);
  }

  .bm-table-head {
    display: none;
  }

  .bm-list {
    border-top: 1px solid var(--bm-border-strong);
    border-bottom: 1px solid var(--bm-border-strong);
  }

  .bm-row {
    border-bottom: 1px solid var(--bm-border);
  }

  .bm-row:last-child {
    border-bottom: 0;
  }

  .bm-row[hidden] {
    display: none;
  }

  .bm-summary {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.3rem 0.65rem;
    padding: 0.65rem 0.5rem;
    cursor: pointer;
    align-items: start;
    transition: background-color 0.12s ease;
  }

  .bm-summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .bm-summary:hover {
      background: var(--bm-surface);
    }
  }

  .bm-row[open] > .bm-summary {
    background: var(--bm-surface);
  }

  .bm-cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.12rem;
  }

  .bm-cell-name {
    grid-column: 1;
  }

  .bm-chevron {
    grid-column: 2;
    grid-row: 1;
    color: var(--theme-sub-text);
    font-size: 0.8rem;
    line-height: 1.5;
    transition: transform 0.15s ease;
    user-select: none;
  }

  .bm-row[open] .bm-chevron {
    transform: rotate(90deg);
    color: var(--theme-text);
  }

  .bm-cell-turn {
    grid-column: 1 / -1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .bm-cell-schema,
  .bm-cell-challenge {
    grid-column: 1 / -1;
