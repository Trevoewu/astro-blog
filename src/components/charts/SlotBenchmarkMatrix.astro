export interface Props {
  lang?: 'en' | 'zh';
  defaultScope?: 'all' | 'deep-dive' | 'landscape';
  defaultTurn?: 'all' | 'single' | 'multi';
}

interface LocalizedText {
  en: string;
  zh: string;
}

type TurnType = 'single' | 'multi';
type ScopeType = 'deep-dive' | 'landscape';
type LangGroup = 'en' | 'multilingual' | 'zh';
type FeatureTag =
  | 'zero-shot'
  | 'nested'
  | 'spoken-asr'
  | 'dst'
  | 'low-resource'
  | 'multi-intent'
  | 'robustness';

interface BenchmarkEntry {
  id: string;
  name: string;
  year: string;
  citation: string;
  turn: TurnType;
  scope: ScopeType;
  langGroup: LangGroup;
  languages: LocalizedText;
  domains: LocalizedText;
  scale: LocalizedText;
  schemaType: LocalizedText;
  tags: FeatureTag[];
  challenge: LocalizedText;
  sotaFull?: LocalizedText;
  sotaZeroShot?: LocalizedText;
  pros?: LocalizedText;
  cons?: LocalizedText;
}

const {
  lang = 'en',
  defaultScope = 'all',
  defaultTurn = 'all',
} = Astro.props;

const isZh = lang === 'zh';
const idPrefix = isZh ? 'zh-' : '';
const t = (text: LocalizedText) => (isZh ? text.zh : text.en);

