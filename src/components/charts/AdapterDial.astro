---
import ResearchPlot from './ResearchPlot.astro';
import data from '@/data/stubborn-slot-filling.json';

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const idPrefix = isZh ? 'zh-' : '';

// Rows contain λ, robustness %, controllability %, then Solo and Advised F1 %.
const scaleKey = (scale: number) => `λ = ${scale}`;
const f1Styles = [
  { label: 'Solo', tone: 'main', column: 3 },
  { label: isZh ? '顾问引导' : 'Advised', tone: 'blue', column: 4 },
] as const;
---

<div class="adapter-dial">
  {Object.entries(data.adapterDial).map(([dataset, rows]) => (
    <section aria-label={isZh ? `${dataset} 适配器权重缩放` : `${dataset} adapter dial`}>
      <div class="plots">
        <ResearchPlot
          lang={lang}
          id={`${idPrefix}dial-${dataset}-conflict`}
          title={isZh ? `${dataset} · 鲁棒性与可控性` : `${dataset} · Robustness and control`}
          xLabel={isZh ? '严格噪声鲁棒性 (%)' : 'Strict noise robustness (%)'}
          yLabel={isZh ? '冲突可控性 (%)' : 'Conflict controllability (%)'}
          xTicks={[0, 20, 40, 60, 80, 100]}
          yTicks={[40, 55, 70, 85, 100]}
          series={[
            {
              label: isZh ? '适配器权重' : 'Adapter scale', tone: 'main',
              points: rows.map(([scale, x, y]) => ({ x, y, key: scaleKey(scale), value: `R ${x.toFixed(2)}%, C ${y.toFixed(2)}%`, annotation: scaleKey(scale) })),
            },
          ]}
        />
        <ResearchPlot
          lang={lang}
          id={`${idPrefix}dial-${dataset}-f1`}
          title={isZh ? `${dataset} · 抽取 F1` : `${dataset} · Extraction F1`}
          xLabel={isZh ? 'LoRA 权重 λ' : 'LoRA scale λ'}
          yLabel={isZh ? '严格片段 F1 (%)' : 'Strict span F1 (%)'}
          xDomain={[-0.04, 1.04]}
          xTicks={[0, 0.25, 0.5, 0.75, 1]}
          yTicks={[40, 50, 60, 70, 80, 90]}
          series={f1Styles.map(({ column, ...style }) => ({
            ...style,
            points: rows.map((row) => ({
              x: row[0], y: row[column], key: scaleKey(row[0]), value: `${row[column].toFixed(2)}%`,
            })),
          }))}
        />
      </div>
    </section>
  ))}
</div>

<style>
  .adapter-dial { display: grid; gap: 1rem; }
  section { container-type: inline-size; }
  .plots { display: grid; gap: 1rem; }

  @container (min-width: 37rem) {
    .plots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }
    .plots > :global(research-plot) {
      /* Share the title, legend, chart, and readout rows. */
      container-type: normal;
      display: grid;
      grid-template-rows: subgrid;
      grid-row: 1 / span 4;
    }
  }
</style>
