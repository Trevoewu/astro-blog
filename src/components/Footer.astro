---
import { LINKS } from '@/consts';
---

<footer>
  <span>
    [↗]: {LINKS.map(({ label, href }) => {
      const isExternal = href.startsWith('http');
      return (
        <><a target={isExternal ? '_blank' : undefined} rel={isExternal ? 'me noopener' : undefined} href={href}>{label}</a>, </>
      );
    })}<a target='_blank' href='/rss.xml'>RSS</a>
  </span>
</footer>

<style>
  footer {
    position: relative;

    padding-top: 1em;
    margin-top: 3em;
  }

  span {
    color: var(--theme-sub-text);
  }

  footer::before {
    content: '';
    position: absolute;

    top: 0;
    width: 25%;

    border-top: 1px solid var(--theme-sub-text);
  }
</style>
